# Fumana server-side secrets. Copy to `.env` and fill in. Never commit `.env`.
#
# These are read by the backend (Vite server middleware) only. They are NOT
# prefixed with VITE_, so Vite never exposes them to the browser bundle — the
# same rule as the Anthropic key (see docs/api_integration_notes.md).

# Text-to-speech (ElevenLabs). Without a key, POST /api/tts returns 501 and the
# browser falls back to SpeechSynthesis, so the interview is never silent.
ELEVENLABS_API_KEY=

# Optional overrides:
# Voice id (default is ElevenLabs' "Rachel"). Pick a warm, calm, African-English
# voice in your ElevenLabs library to match Zuri's voice charter.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
