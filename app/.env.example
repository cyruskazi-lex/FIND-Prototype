# Fumana server-side secrets. Copy to `.env` and fill in. Never commit `.env`.
#
# These are read by the backend (Vite server middleware) only. They are NOT
# prefixed with VITE_, so Vite never exposes them to the browser bundle — the
# same rule as the Anthropic key (see docs/api_integration_notes.md).

# Demo mode. When true, POST /api/claude returns realistic pre-built responses
# and no provider is called, so the whole app is live with no API key. Set to
# false (and configure a provider below) to go live. See .env.demo.
DEMO_MODE=false

# Language model (provider-agnostic). The browser calls POST /api/claude; the
# backend calls the chosen provider with these. Switching providers is just
# these lines — no app-code changes. Leave unset and POST /api/claude returns
# 501, keeping scoring, the copilots, and the Experience Alchemist inert.
#   LLM_PROVIDER: anthropic | openai
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override (else a per-provider default):
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-4o-mini
LLM_MODEL=

# Text-to-speech (ElevenLabs). Without a key, POST /api/tts returns 501 and the
# browser falls back to SpeechSynthesis, so the interview is never silent.
ELEVENLABS_API_KEY=

# Optional overrides:
# Voice id (default is ElevenLabs' "Rachel"). Pick a warm, calm, African-English
# voice in your ElevenLabs library to match Zuri's voice charter.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
